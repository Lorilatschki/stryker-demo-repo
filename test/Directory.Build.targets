<Project>
  <PropertyGroup Condition="'$(ThisIsATestProject)' == 'true'">
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ThisIsATestProject)' != 'true' AND '$(DisableOutputTypeOverride)' != 'true'">
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <Target Name="CheckThisIsATestProject" Condition="'$(MSBuildProjectName)' != 'BenchmarkDotNet.Autogenerated'" BeforeTargets="BeforeBuild">
    <Error Condition="'$(ThisIsATestProject)' == ''" Text="The property 'ThisIsATestProject' is not defined in your test project. Please define it in the project file." />
  </Target>
  <Target Name="CheckTestProjectConditions" Condition="'$(ThisIsATestProject)' == 'true'" BeforeTargets="BeforeBuild">
    <Error Condition="'$(TestingPlatformDotnetTestSupport)' == '' OR '$(TestingPlatformDotnetTestSupport)' == 'false'" Text="Please set 'TestingPlatformDotnetTestSupport' to true in your test project otherwise pipeline test integration may produce incorrect results." />
    <Error Condition="'$(UseMicrosoftTestingPlatformRunner)' == '' OR '$(UseMicrosoftTestingPlatformRunner)' == 'false'" Text="Please set 'UseMicrosoftTestingPlatformRunner' to true in your test project otherwise pipeline test integration may produce incorrect results." />
  </Target>

  <!--
    Generates a "<AssemblyName>.uniqueid" file containing the assembly name to ensure unique test node ids
    are generated by XUNIT independent of the OS (see issue discussion https://github.com/xunit/xunit/issues/3419#issuecomment-3419774531).
    Running before AssignTargetPaths ensures the item is known in time for the SDK's GetCopyToOutputDirectoryItems logic,
    so the file is also copied into the output directory of any project that references this one via ProjectReference (in addition to this
    project's own output and, for PackageReference consumers, via this build/ props file).    
  -->
  <Target Name="WriteTestAssemblyUniqueIdFile" Condition="'$(ThisIsATestProject)' == 'true'" BeforeTargets="BeforeBuild;AssignTargetPaths">
    <PropertyGroup>
      <_TestAssemblyUniqueIdFile>$(IntermediateOutputPath)$(AssemblyName).uniqueid</_TestAssemblyUniqueIdFile>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(_TestAssemblyUniqueIdFile)"
      Lines="$(AssemblyName)"
      Overwrite="true" />
    <ItemGroup>
      <None Include="$(_TestAssemblyUniqueIdFile)" CopyToOutputDirectory="PreserveNewest" Link="$(AssemblyName).uniqueid" Pack="false" Visible="false" />
      <FileWrites Include="$(_TestAssemblyUniqueIdFile)" />
    </ItemGroup>
  </Target>
</Project>

